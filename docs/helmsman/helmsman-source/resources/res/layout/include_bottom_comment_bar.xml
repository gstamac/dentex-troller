<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="120px">
    <FrameLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/frame_item_my_following_favourite"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/linear_my_following_favourite"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/iv_myroute_heart_like"
                android:layout_width="44px"
                android:layout_height="37px"
                android:src="0x7f070200"/>
            <TextView
                android:textSize="37px"
                android:textColor="#a1a1a1"
                android:id="@+id/tv_item_my_folowing_favourite"
                android:paddingLeft="14px"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/Favourite"/>
        </LinearLayout>
        <View
            android:layout_gravity="center"
            android:background="@color/gray_lite"
            android:layout_width="1dp"
            android:layout_height="16dp"/>
    </FrameLayout>
    <FrameLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/tlinear_item_my_following_download"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_width="44px"
                android:layout_height="42px"
                android:src="0x7f0701ff"/>
            <TextView
                android:textSize="37px"
                android:textColor="#a1a1a1"
                android:id="@+id/tv_item_my_following_download"
                android:paddingLeft="12px"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/download"/>
        </LinearLayout>
        <View
            android:layout_gravity="center"
            android:background="@color/gray_lite"
            android:layout_width="1dp"
            android:layout_height="16dp"/>
    </FrameLayout>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/lin_item_my_following_comment"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">
        <ImageView
            android:layout_width="44px"
            android:layout_height="39px"
            android:src="0x7f0701fe"/>
        <TextView
            android:textSize="37px"
            android:textColor="#a1a1a1"
            android:id="@+id/tv_item_my_following_comment"
            android:paddingLeft="14px"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/Comment"/>
    </LinearLayout>
</LinearLayout>
