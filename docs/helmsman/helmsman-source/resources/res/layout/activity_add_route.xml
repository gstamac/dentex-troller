<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:fitsSystemWindows="true"
    android:clipToPadding="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/frame_add_route_google_map"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="-420px">
        <ViewStub
            android:id="@+id/vs_google_map"
            android:layout="@layout/layout_googlemap"
            android:layout_width="1920px"
            android:layout_height="match_parent"/>
        <ViewStub
            android:id="@+id/vs_gaode_map"
            android:layout="@layout/layout_gaodemap"
            android:layout_width="1920px"
            android:layout_height="match_parent"/>
    </FrameLayout>
    <ImageView
        android:id="@+id/iv_add_route_black_dismiss"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_margin="16dp"
        android:src="@drawable/icon_add_route_black_dismiss"/>
    <ImageView
        android:id="@+id/iv_add_route_save"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginLeft="10dp"
        android:src="@drawable/icon_add_route_save"
        android:layout_centerVertical="true"/>
    <ImageView
        android:id="@+id/iv_add_route_reverse"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="10dp"
        android:src="@drawable/icon_add_route_reverse"
        android:layout_below="@+id/iv_add_route_save"/>
    <ImageView
        android:id="@+id/iv_add_route_map_mode_satellite"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_margin="10dp"
        android:src="@drawable/icon_add_route_map_mode_satellite"
        android:layout_alignParentRight="true"/>
    <ImageView
        android:id="@+id/iv_add_route_map_route_locateboat"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="74dp"
        android:layout_marginRight="10dp"
        android:src="@drawable/icon_add_route_locateboat"
        android:layout_alignParentRight="true"/>
    <ImageView
        android:id="@+id/iv_add_route_delete"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginRight="10dp"
        android:src="@drawable/icon_add_route_delete"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"/>
    <ImageView
        android:id="@+id/iv_add_route_start_autopilot"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="10dp"
        android:layout_marginRight="10dp"
        android:src="@drawable/icon_add_route_start_autopilot"
        android:layout_below="@+id/iv_add_route_delete"
        android:layout_alignParentRight="true"/>
    <RelativeLayout
        android:id="@+id/rel_add_route_under"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="160dp"
        android:layout_alignParentBottom="true">
        <HorizontalScrollView
            android:id="@+id/sc_add_route_under"
            android:background="@color/white"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="50dp">
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/lin_add_route_select_marker"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </HorizontalScrollView>
        <RelativeLayout
            android:id="@+id/rel_add_route_under_bottom"
            android:background="@color/black"
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:layout_below="@+id/sc_add_route_under">
            <RelativeLayout
                android:id="@+id/rel_add_route_under_left_num"
                android:background="@drawable/bg_add_route_under"
                android:layout_width="110dp"
                android:layout_height="match_parent">
                <TextView
                    android:textSize="35dp"
                    android:textColor="@color/white"
                    android:id="@+id/tv_add_route_under_left_num"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1"
                    android:layout_centerInParent="true"/>
            </RelativeLayout>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_toRightOf="@+id/rel_add_route_under_left_num">
                <RelativeLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <TextView
                        android:textSize="18sp"
                        android:textColor="@color/white"
                        android:id="@+id/tv_add_route_under_longitude"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2222222222&apos;E"
                        android:layout_centerInParent="true"/>
                </RelativeLayout>
                <RelativeLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <TextView
                        android:textSize="18sp"
                        android:textColor="@color/white"
                        android:id="@+id/tv_add_route_under_latitude"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2222222222&apos;N"
                        android:layout_centerInParent="true"/>
                </RelativeLayout>
            </LinearLayout>
            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_alignParentRight="true">
                <TextView
                    android:textSize="18sp"
                    android:textColor="@color/white"
                    android:id="@+id/tv_add_route_under_dis"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="30dp"
                    android:text="2222.2KM"
                    android:layout_centerInParent="true"/>
            </RelativeLayout>
        </RelativeLayout>
    </RelativeLayout>
    <FrameLayout
        android:id="@+id/frame_add_route_top"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <FrameLayout
        android:id="@+id/frame_add_route_top2"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</RelativeLayout>
