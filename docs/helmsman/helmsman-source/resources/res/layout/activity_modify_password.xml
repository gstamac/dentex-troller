<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/activity_modify_password"
    android:fitsSystemWindows="true"
    android:clipToPadding="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/cardview"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="5dp">
        <im.helmsman.helmsmanandroid.view.TitleBar
            android:id="@+id/titleBar"
            android:background="@color/title_red"
            android:layout_width="match_parent"
            android:layout_height="168px"
            app:left_drawable="0x7f0701db"
            app:textColor="@color/white"
            app:title="@string/password">
            <ImageView
                android:id="@+id/iv_edit_new_userinfo_tick"
                android:visibility="gone"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginRight="19dp"
                android:src="0x7f070250"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"/>
        </im.helmsman.helmsmanandroid.view.TitleBar>
    </FrameLayout>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/black"
        android:id="@+id/tv_modify_password_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="17dp"
        android:text="@string/password"
        android:layout_below="@+id/cardview"/>
    <EditText
        android:textColorHint="#d8d8d8"
        android:id="@+id/et_modify_password"
        android:layout_width="327dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="7dp"
        android:hint="@string/password"
        android:layout_below="@+id/tv_modify_password_hint"
        android:inputType="textPassword"/>
    <ImageView
        android:id="@+id/iv_password_trip"
        android:paddingBottom="13dp"
        android:visibility="gone"
        android:layout_width="16dp"
        android:layout_height="29dp"
        android:layout_marginRight="16dp"
        android:src="@drawable/icon_login_correct"
        android:layout_alignRight="@+id/et_modify_password"
        android:layout_alignBottom="@+id/et_modify_password"
        android:layout_alignParentRight="true"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/black"
        android:id="@+id/tv_modify_newpassword_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="17dp"
        android:text="@string/newpassword"
        android:layout_below="@+id/et_modify_password"/>
    <EditText
        android:textColorHint="#d8d8d8"
        android:id="@+id/et_modify_newpassword"
        android:layout_width="327dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="7dp"
        android:hint="@string/newpassword"
        android:layout_below="@+id/tv_modify_newpassword_hint"
        android:inputType="textPassword"/>
    <ImageView
        android:id="@+id/iv_newpassword_trip"
        android:paddingBottom="13dp"
        android:visibility="gone"
        android:layout_width="16dp"
        android:layout_height="29dp"
        android:layout_marginRight="16dp"
        android:src="@drawable/icon_login_correct"
        android:layout_alignBottom="@+id/et_modify_newpassword"
        android:layout_alignParentRight="true"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/black"
        android:id="@+id/tv_modify_confirm_password_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="17dp"
        android:text="@string/confirm"
        android:layout_below="@+id/et_modify_newpassword"/>
    <EditText
        android:textColorHint="#d8d8d8"
        android:id="@+id/et_modify_confirm_password"
        android:layout_width="327dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="7dp"
        android:hint="@string/password"
        android:layout_below="@+id/tv_modify_confirm_password_hint"
        android:inputType="textPassword"/>
    <ImageView
        android:id="@+id/iv_confirmpassword_trip"
        android:paddingBottom="13dp"
        android:visibility="gone"
        android:layout_width="16dp"
        android:layout_height="29dp"
        android:layout_marginRight="16dp"
        android:src="@drawable/icon_login_correct"
        android:layout_alignBottom="@+id/et_modify_confirm_password"
        android:layout_alignParentRight="true"/>
</RelativeLayout>
