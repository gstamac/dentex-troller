<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:clipToPadding="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    style="@style/AppBaseTheme_whiteLine">
    <im.helmsman.helmsmanandroid.view.TitleBar
        android:id="@+id/titlebar"
        android:background="@color/title_red"
        android:layout_width="match_parent"
        android:layout_height="168px"
        app:left_drawable="0x7f0701db">
        <im.helmsman.helmsmanandroid.view.SearchView
            android:id="@+id/seachview_addFriends_searchfiends_"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="160px"
            android:layout_centerVertical="true"/>
    </im.helmsman.helmsmanandroid.view.TitleBar>
    <LinearLayout
        android:orientation="vertical"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RelativeLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textColor="#7a7a7a"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="50px"
                android:text="@string/search_result"/>
            <com.tt.whorlviewlibrary.WhorlView
                android:id="@+id/whorlview_addfriend_progressbar"
                android:visibility="gone"
                android:layout_width="120px"
                android:layout_height="120px"
                android:layout_marginTop="100px"
                android:layout_centerHorizontal="true"
                app:whorlview_circle_colors="#F14336"
                app:whorlview_circle_speed="270"
                app:whorlview_parallax="fast"
                app:whorlview_strokeWidth="6"
                app:whorlview_sweepAngle="90"/>
        </RelativeLayout>
        <com.chanven.lib.cptr.PtrClassicFrameLayout
            android:id="@+id/ptr_addfriends_refresh"
            android:layout_width="wrap_content"
            android:layout_height="match_parent">
            <ListView
                android:id="@+id/lv_addfriend_friendlist"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:divider="@drawable/listline_magrinleft"
                android:dividerHeight="3px"/>
        </com.chanven.lib.cptr.PtrClassicFrameLayout>
    </LinearLayout>
</LinearLayout>
