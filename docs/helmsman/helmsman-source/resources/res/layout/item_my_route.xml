<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:descendantFocusability="blocksDescendants"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="2dp"
    app:cardElevation="20px">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:background="@android:color/white"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/civ_my_following_portrait"
                android:layout_width="51dp"
                android:layout_height="51dp"
                android:layout_marginLeft="48px"
                android:layout_marginTop="48px"
                android:src="0x7f0701cc"
                android:layout_alignParentStart="true"
                app:civ_border_color="#9b9b9b"
                app:civ_border_width="1dp"/>
            <LinearLayout
                android:orientation="vertical"
                android:paddingLeft="48px"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignTop="@+id/civ_my_following_portrait"
                android:layout_toEndOf="@+id/civ_my_following_portrait">
                <TextView
                    android:textSize="18sp"
                    android:textColor="@color/black"
                    android:id="@+id/tv_item_my_following_author"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No Name"/>
                <TextView
                    android:textSize="14sp"
                    android:id="@+id/tv_item_my_folowing_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12px"
                    android:text="0 min ago"/>
            </LinearLayout>
            <ImageButton
                android:id="@+id/iv_my_route_share"
                android:background="@drawable/ripple_tran_bg"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginTop="28dp"
                android:layout_marginRight="16dp"
                android:src="0x7f07024c"
                android:layout_alignParentRight="true"/>
        </RelativeLayout>
        <TextView
            android:layout_gravity="center_vertical"
            android:id="@+id/tv_item_my_following_description"
            android:background="#00ffffff"
            android:paddingLeft="48px"
            android:paddingRight="16dp"
            android:paddingBottom="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <FrameLayout
            android:background="@drawable/ripple_bg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/iv_item_my_following_route"
                android:layout_width="match_parent"
                android:layout_height="1080px"
                android:scaleType="centerCrop"
                android:layout_centerInParent="true"/>
            <Button
                android:textSize="22sp"
                android:gravity="top|center_horizontal"
                android:layout_gravity="right"
                android:id="@+id/btn_item_my_following_waypoint_count"
                android:background="@drawable/icon_way_point_counter"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginTop="16dp"
                android:layout_marginRight="16dp"
                android:text="0"/>
            <RelativeLayout
                android:layout_gravity="bottom"
                android:background="@drawable/bg_way_point_content"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:layout_width="match_parent"
                android:layout_height="216px">
                <de.hdodenhof.circleimageview.CircleImageView
                    android:id="@+id/cir_myroute_creatorHead"
                    android:layout_width="108px"
                    android:layout_height="108px"
                    android:src="@drawable/icon_way_point_content_left"
                    android:layout_centerVertical="true"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true">
                    <TextView
                        android:textSize="48px"
                        android:textColor="@color/black"
                        android:id="@+id/tv_myroute_creator_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="120px"
                        android:text="No Name"/>
                    <TextView
                        android:id="@+id/tv_myroute_route_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="120px"
                        android:text="route name"
                        android:layout_below="@+id/tv_myroute_creator_name"/>
                </LinearLayout>
                <TextView
                    android:textSize="@dimen/edit_route_dis_size"
                    android:textColor="@color/black"
                    android:id="@+id/tv_item_my_following_dis"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 KM"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"/>
            </RelativeLayout>
        </FrameLayout>
        <include layout="@layout/include_bottom_comment_bar"/>
    </LinearLayout>
</androidx.cardview.widget.CardView>
