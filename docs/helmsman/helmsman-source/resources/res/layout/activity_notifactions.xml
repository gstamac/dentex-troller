<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/activity_notifactions"
    android:fitsSystemWindows="true"
    android:clipToPadding="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="5dp">
        <im.helmsman.helmsmanandroid.view.TitleBar
            android:id="@+id/titleBar"
            android:background="@color/title_red"
            android:layout_width="match_parent"
            android:layout_height="168px"
            app:left_drawable="0x7f0701db"
            app:textColor="@color/white"
            app:title="@string/notification"/>
    </FrameLayout>
    <RelativeLayout
        android:id="@+id/rel_notification_comments"
        android:layout_width="match_parent"
        android:layout_height="145px"
        android:layout_marginTop="24px">
        <ImageView
            android:layout_width="70px"
            android:layout_height="70px"
            android:layout_marginLeft="49px"
            android:src="0x7f070228"
            android:layout_centerVertical="true"/>
        <TextView
            android:textSize="48px"
            android:textColor="@color/black"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="216px"
            android:text="@string/Comments"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/rel_notification_favourite"
        android:layout_width="match_parent"
        android:layout_height="145px"
        android:layout_marginTop="24px">
        <ImageView
            android:layout_width="70px"
            android:layout_height="70px"
            android:layout_marginLeft="49px"
            android:src="0x7f070201"
            android:layout_centerVertical="true"/>
        <TextView
            android:textSize="48px"
            android:textColor="@color/black"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="216px"
            android:text="@string/Favourite"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
</LinearLayout>
