<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/rel_edit_route"
    android:background="@color/white"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:fitsSystemWindows="true"
    android:clipToPadding="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="5dp">
        <im.helmsman.helmsmanandroid.view.TitleBar
            android:id="@+id/titleBar"
            android:background="@color/title_red"
            android:layout_width="match_parent"
            android:layout_height="168px"
            app:left_drawable="0x7f0701db"
            app:textColor="@color/white"
            app:title="@string/edit_route"/>
    </FrameLayout>
    <ScrollView
        android:id="@+id/sv_edit_route"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <RelativeLayout
                android:id="@+id/rel_edit_route_map"
                android:layout_width="match_parent"
                android:layout_height="350dp">
                <ImageView
                    android:id="@+id/iv_waypoint_image"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitXY"
                    android:layout_centerInParent="true"/>
                <RelativeLayout
                    android:id="@+id/rel_edit_route_nomap"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_centerInParent="true">
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="0x7f07025a"
                        android:layout_centerInParent="true"/>
                </RelativeLayout>
                <RelativeLayout
                    android:background="@drawable/icon_way_point_counter"
                    android:layout_width="65dp"
                    android:layout_height="65dp"
                    android:layout_margin="20dp"
                    android:layout_alignParentRight="true">
                    <TextView
                        android:textSize="26sp"
                        android:textColor="@color/black"
                        android:gravity="clip_horizontal"
                        android:id="@+id/tv_way_point_counter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="4"
                        android:layout_centerHorizontal="true"/>
                </RelativeLayout>
                <RelativeLayout
                    android:background="@drawable/bg_way_point_content"
                    android:layout_width="match_parent"
                    android:layout_height="70dp"
                    android:layout_alignParentBottom="true">
                    <ImageView
                        android:id="@+id/iv_way_point_content_left"
                        android:padding="15dp"
                        android:layout_width="60dp"
                        android:layout_height="wrap_content"
                        android:src="@drawable/icon_way_point_content_left"/>
                    <TextView
                        android:textSize="@dimen/edit_route_name_size"
                        android:textColor="@color/black"
                        android:id="@+id/tv_way_point_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/edit_no_name"
                        android:layout_toRightOf="@+id/iv_way_point_content_left"/>
                    <TextView
                        android:textSize="@dimen/edit_route_time_size"
                        android:textColor="@color/black"
                        android:id="@+id/tv_way_point_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1/22/16,16:18"
                        android:layout_toRightOf="@+id/iv_way_point_content_left"
                        android:layout_below="@+id/tv_way_point_name"/>
                    <TextView
                        android:textSize="@dimen/edit_route_dis_size"
                        android:textColor="@color/black"
                        android:id="@+id/tv_way_point_dis"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="20dp"
                        android:text="1.1KM"
                        android:layout_alignParentRight="true"
                        android:layout_centerVertical="true"/>
                </RelativeLayout>
            </RelativeLayout>
            <LinearLayout
                android:id="@+id/line_edit_share"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_margin="10dp"
                android:layout_below="@+id/rel_edit_route_map">
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/iv_edit_route_wechat"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_margin="10dp"
                    android:src="@drawable/icon_edit_route_wechat"/>
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_margin="10dp"
                    android:src="@drawable/icon_edit_route_fb"/>
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_margin="10dp"
                    android:src="@drawable/icon_edit_route_twitter"/>
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_margin="10dp"
                    android:src="@drawable/icon_edit_route_weibo"/>
            </LinearLayout>
            <RelativeLayout
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_marginRight="10dp"
                android:layout_marginBottom="10dp"
                android:layout_below="@+id/line_edit_share">
                <EditText
                    android:textColorHint="@color/gray_lite"
                    android:id="@+id/et_editroute_waypointname"
                    android:background="@drawable/bg_edit_route_edittext"
                    android:paddingLeft="13dp"
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:hint="@string/edit_name_here"
                    android:singleLine="true"/>
            </RelativeLayout>
            <Button
                android:textColor="@color/white"
                android:id="@+id/bt_editroute_done"
                android:background="@color/main_red"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:layout_marginLeft="10dp"
                android:layout_marginTop="10dp"
                android:layout_marginRight="10dp"
                android:layout_marginBottom="15dp"
                android:text="@string/edit_done"
                android:layout_below="@+id/et_editroute_waypointname"
                android:layout_alignParentLeft="true"
                android:layout_alignParentStart="true"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
