<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:clipToPadding="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="5dp">
        <im.helmsman.helmsmanandroid.view.TitleBar
            android:id="@+id/titleBar"
            android:background="@color/title_red"
            android:layout_width="match_parent"
            android:layout_height="168px"
            app:left_drawable="0x7f0701db"
            app:textColor="@color/white"
            app:title="@string/setting_my_devices"/>
    </FrameLayout>
    <im.helmsman.helmsmanandroid.view.OverScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RelativeLayout
                android:background="@drawable/bg_setting_item_no_underline"
                android:padding="16dp"
                android:layout_width="match_parent"
                android:layout_height="@dimen/item_height"
                android:layout_marginTop="24px">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/mydevice_product_name"
                    android:layout_centerVertical="true"/>
                <TextView
                    android:textColor="@android:color/darker_gray"
                    android:id="@+id/tv_mydevices_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="device_name"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"/>
            </RelativeLayout>
            <RelativeLayout
                android:background="@drawable/ripple_bg"
                android:padding="16dp"
                android:layout_width="match_parent"
                android:layout_height="@dimen/item_height">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/mydevice_product_mode"
                    android:layout_centerVertical="true"/>
                <TextView
                    android:textColor="@android:color/darker_gray"
                    android:id="@+id/tv_mydevices_mode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="50736~"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"/>
            </RelativeLayout>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginLeft="16dp"
                android:layout_alignParentBottom="true"/>
            <RelativeLayout
                android:background="@drawable/ripple_bg"
                android:padding="16dp"
                android:layout_width="match_parent"
                android:layout_height="@dimen/item_height">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/mydevice_firmware_version"
                    android:layout_centerVertical="true"/>
                <TextView
                    android:textColor="@android:color/darker_gray"
                    android:id="@+id/tv_mydevices_version"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="101"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"/>
            </RelativeLayout>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginLeft="16dp"
                android:layout_alignParentBottom="true"/>
            <RelativeLayout
                android:background="@drawable/ripple_bg"
                android:padding="12dp"
                android:layout_width="match_parent"
                android:layout_height="@dimen/item_height">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/mydevice_manufacturer"
                    android:layout_centerVertical="true"/>
                <TextView
                    android:textColor="@android:color/darker_gray"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/mydevice_haswing"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"/>
            </RelativeLayout>
        </LinearLayout>
    </im.helmsman.helmsmanandroid.view.OverScrollView>
</LinearLayout>
