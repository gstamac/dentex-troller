<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_main_menu"
    android:background="#000000"
    android:fitsSystemWindows="true"
    android:clipToPadding="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RelativeLayout
            android:id="@+id/rel_main_nav"
            android:layout_width="match_parent"
            android:layout_height="135px">
            <ImageButton
                android:id="@+id/ib_main_setting"
                android:background="#000000"
                android:padding="20px"
                android:layout_width="110px"
                android:layout_height="110px"
                android:layout_marginLeft="20px"
                android:src="0x7f0701f4"
                android:scaleType="fitCenter"
                android:layout_centerVertical="true"/>
            <ImageButton
                android:id="@+id/ib_main_eye"
                android:background="#000000"
                android:padding="20px"
                android:layout_width="110px"
                android:layout_height="110px"
                android:layout_marginLeft="210px"
                android:src="@drawable/icon_main_eye_selector"
                android:scaleType="fitCenter"
                android:layout_centerVertical="true"/>
            <TextView
                android:textSize="20sp"
                android:textColor="#ffffff"
                android:id="@+id/tv_main_title"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/main_titlename"
                android:layout_centerInParent="true"/>
            <ImageView
                android:id="@+id/iv_main_redheart"
                android:visibility="gone"
                android:layout_width="85px"
                android:layout_height="85px"
                android:src="@drawable/icon_redheart"
                android:layout_centerInParent="true"/>
            <ImageButton
                android:id="@+id/ib_main_transfer_station"
                android:background="#000000"
                android:padding="20px"
                android:layout_width="88px"
                android:layout_height="110px"
                android:layout_marginRight="38px"
                android:src="0x7f070252"
                android:scaleType="fitCenter"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"/>
        </RelativeLayout>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/rel_main_nav">
            <ViewStub
                android:id="@+id/vs_gaode_map"
                android:layout="@layout/layout_gaodemap"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <ViewStub
                android:id="@+id/vs_google_map"
                android:layout="@layout/layout_googlemap"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <ImageView
                android:id="@+id/iv_main_scrub_bac"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"/>
            <ImageView
                android:id="@+id/iv_main_delete"
                android:visibility="gone"
                android:layout_width="112px"
                android:layout_height="112px"
                android:layout_marginLeft="25px"
                android:layout_marginTop="58px"
                android:src="@drawable/icon_main_delete"/>
            <LinearLayout
                android:id="@+id/lin_main_eye"
                android:background="#000000"
                android:padding="25px"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/iv_main_map_mode_satellite"
                    android:layout_width="112px"
                    android:layout_height="112px"
                    android:src="@drawable/icon_main_map_mode_satellite"
                    android:layout_weight="1"/>
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/iv_mian_locate_boat"
                    android:layout_width="112px"
                    android:layout_height="112px"
                    android:src="@drawable/icon_main_locate_boat"
                    android:layout_weight="1"/>
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/iv_main_icon_no_track_boat"
                    android:layout_width="112px"
                    android:layout_height="112px"
                    android:src="0x7f070251"
                    android:layout_weight="1"/>
            </LinearLayout>
        </FrameLayout>
        <ImageView
            android:id="@+id/iv_main_route"
            android:layout_width="112px"
            android:layout_height="112px"
            android:layout_marginLeft="10px"
            android:src="0x7f070222"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"/>
        <im.helmsman.helmsmanandroid.view.LightImage
            android:id="@+id/iv_main_record"
            android:visibility="gone"
            android:layout_width="112px"
            android:layout_height="112px"
            android:layout_marginRight="25px"
            android:src="@drawable/icon_record_red"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"/>
        <ImageView
            android:id="@+id/iv_main_exit_function"
            android:visibility="gone"
            android:layout_width="90px"
            android:layout_height="135px"
            android:layout_marginRight="25px"
            android:src="0x7f070217"
            android:scaleType="fitXY"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"/>
        <im.helmsman.helmsmanandroid.view.AutoArcMenu
            android:id="@+id/main_arc_menu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="8dp"
            android:scaleType="fitCenter"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            app:childSize="35dp"
            app:fromDegrees="245"
            app:toDegrees="120"/>
        <ImageView
            android:background="#e5555555"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="275px"
            android:layout_marginBottom="225px"/>
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true">
            <View
                android:layout_gravity="bottom"
                android:background="#515a5c"
                android:layout_width="match_parent"
                android:layout_height="260px"/>
            <im.helmsman.helmsmanandroid.view.Rudder
                android:layout_gravity="bottom|center_horizontal"
                android:id="@+id/ctr_main_boatctr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:keepScreenOn="true"/>
            <im.helmsman.helmsmanandroid.view.CtrlButton
                android:layout_gravity="bottom|left"
                android:id="@+id/ctrlButton_main_wifi"
                android:clickable="true"
                android:layout_width="63dp"
                android:layout_height="63dp"
                android:layout_marginLeft="40dp"
                android:layout_marginBottom="118dp"
                app:viewdrawable="@drawable/icon_nowifi"/>
            <TextView
                android:textSize="22sp"
                android:textColor="#ffffff"
                android:gravity="bottom|center_horizontal"
                android:layout_gravity="bottom|left"
                android:id="@+id/tv_main_speedmeter"
                android:background="@drawable/bg_meter"
                android:paddingBottom="11dp"
                android:clickable="true"
                android:layout_width="62dp"
                android:layout_height="62dp"
                android:layout_marginLeft="43dp"
                android:layout_marginBottom="1dp"
                android:text="0.0\10km/h"
                android:lineSpacingExtra="5px"
                android:lineSpacingMultiplier="0.9"
                app:layout_auto_basewidth="height"/>
            <RelativeLayout
                android:layout_gravity="bottom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="48dp">
                <ImageView
                    android:layout_gravity="bottom|left"
                    android:id="@+id/image_main_motorspeed"
                    android:layout_width="82dp"
                    android:layout_height="82dp"
                    android:src="@drawable/icon_motorspeed0"/>
                <ImageView
                    android:layout_gravity="bottom|left"
                    android:id="@+id/btn_main_motor"
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:layout_margin="6dp"
                    android:src="0x7f07023e"
                    android:scaleType="fitCenter"/>
            </RelativeLayout>
            <RelativeLayout
                android:layout_gravity="bottom|right"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="40dp"
                android:layout_marginBottom="118dp">
                <View
                    android:background="@drawable/bg_meter"
                    android:clickable="true"
                    android:layout_width="63dp"
                    android:layout_height="63dp"
                    app:layout_auto_basewidth="height"/>
                <ImageView
                    android:id="@+id/iv_main_gpsSignal"
                    android:padding="15dp"
                    android:layout_width="63dp"
                    android:layout_height="63dp"
                    android:src="@drawable/icon_gpssignal_red"/>
                <com.mikhaellopez.circularprogressbar.CircularProgressBar
                    android:id="@+id/pb_main_gps_circular"
                    android:layout_width="63dp"
                    android:layout_height="63dp"
                    app:cpb_background_progressbar_color="@color/black"
                    app:cpb_background_progressbar_width="5px"
                    app:cpb_progressbar_color="@color/main_connection_correct_bg"
                    app:cpb_progressbar_width="5px"/>
            </RelativeLayout>
            <im.helmsman.helmsmanandroid.view.CtrlButton
                android:layout_gravity="bottom|right"
                android:id="@+id/ctrlButton_main_battery"
                android:clickable="true"
                android:layout_width="62dp"
                android:layout_height="62dp"
                android:layout_marginRight="43dp"
                android:layout_marginBottom="1dp"
                app:viewdrawable="@drawable/icon_batteryfull"/>
            <im.helmsman.helmsmanandroid.view.CtrlButton
                android:layout_gravity="bottom|right"
                android:id="@+id/ctrlButton_main_mode"
                android:clickable="true"
                android:layout_width="82dp"
                android:layout_height="82dp"
                android:layout_marginBottom="48dp"
                app:viewdrawable="0x7f0701ef"/>
        </FrameLayout>
    </RelativeLayout>
    <fragment
        android:name="im.helmsman.helmsmanandroid.ui.fragment.MainDrawerMenuFragment"
        android:layout_gravity="left"
        android:tag="LEFT"
        android:layout_width="262dp"
        android:layout_height="match_parent"/>
</androidx.drawerlayout.widget.DrawerLayout>
