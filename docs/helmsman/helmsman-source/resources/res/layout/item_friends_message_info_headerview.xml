<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:clipToPadding="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/iv_friendsmessageinfo_bg"
        android:layout_width="match_parent"
        android:layout_height="818px"
        android:src="0x7f07006a"
        android:scaleType="fitXY"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <im.helmsman.helmsmanandroid.view.TitleBar
            android:id="@+id/titleBar"
            android:background="@android:color/transparent"
            android:layout_width="match_parent"
            android:layout_height="180px"
            app:left_drawable="@drawable/test"
            app:right_icon_height="48px"
            app:right_icon_width="48px">
            <ImageView
                android:id="@+id/iv_friendsmessageinfo_follow"
                android:padding="10px"
                android:layout_width="100px"
                android:layout_height="100px"
                android:layout_marginTop="33px"
                android:layout_marginRight="52px"
                android:src="0x7f070256"
                android:layout_alignParentRight="true"/>
            <ProgressBar
                android:id="@+id/pb_friendsmessageinfo_progress"
                android:visibility="gone"
                android:layout_width="100px"
                android:layout_height="100px"
                android:layout_marginTop="43px"
                android:layout_marginRight="62px"
                android:layout_alignParentRight="true"/>
        </im.helmsman.helmsmanandroid.view.TitleBar>
        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/civ_friendsmessageinfo_avatar"
            android:layout_width="66dp"
            android:layout_height="66dp"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="72dp"
            android:src="0x7f0701cc"/>
        <TextView
            android:textSize="20sp"
            android:textColor="@color/white"
            android:id="@+id/tv_friendsmessageinfo_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:text="name"
            android:layout_toRightOf="@+id/civ_friendsmessageinfo_avatar"
            android:layout_alignTop="@+id/civ_friendsmessageinfo_avatar"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:textColor="@color/white"
            android:ellipsize="end"
            android:id="@+id/tv_friendsmessageinfo_content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:maxWidth="246dp"
            android:text=""
            android:maxLines="2"
            android:layout_toRightOf="@+id/civ_friendsmessageinfo_avatar"
            android:layout_alignBottom="@+id/civ_friendsmessageinfo_avatar"
            android:layout_centerHorizontal="true"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/linear_followerfollowing"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30px"
            android:layout_below="@+id/tv_friendsmessageinfo_content"
            android:layout_centerHorizontal="true">
            <TextView
                android:textColor="@android:color/white"
                android:gravity="center"
                android:id="@+id/tv_friendmessageinfo_follow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Follow 0"
                android:layout_below="@+id/civ_friendsmessageinfo_avatar"
                android:lineSpacingMultiplier="0.6"/>
            <TextView
                android:textColor="@android:color/white"
                android:gravity="center"
                android:id="@+id/tv_friendmessageinfo_follower"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="240px"
                android:text="Following 0"
                android:layout_below="@+id/civ_friendsmessageinfo_avatar"
                android:lineSpacingMultiplier="0.6"/>
        </LinearLayout>
    </RelativeLayout>
</RelativeLayout>
