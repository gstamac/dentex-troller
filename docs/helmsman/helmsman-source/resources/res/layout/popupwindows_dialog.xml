<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="42px"
        android:textColor="#ff4a49"
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="9.7dp"
        android:layout_marginTop="9.7dp"/>
    <View
        android:id="@+id/view_line"
        android:background="#ff4a49"
        android:layout_width="match_parent"
        android:layout_height="1.3dp"
        android:layout_marginTop="36.5dp"/>
    <TextView
        android:textSize="36px"
        android:textColor="@color/black"
        android:id="@+id/tv_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="9.7dp"
        android:layout_marginTop="8.86dp"
        android:layout_marginRight="9.7dp"
        android:layout_below="@+id/view_line"
        android:layout_centerHorizontal="true"/>
    <View
        android:id="@+id/view_line2"
        android:background="#d5d5d5"
        android:layout_width="match_parent"
        android:layout_height="0.65dp"
        android:layout_marginTop="6.56dp"
        android:layout_below="@+id/tv_content"/>
    <RelativeLayout
        android:id="@+id/rel_byn"
        android:layout_width="match_parent"
        android:layout_height="30.7dp"
        android:layout_below="@+id/view_line2">
        <TextView
            android:textSize="27.4px"
            android:textColor="@color/black"
            android:id="@+id/tv_button_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
</RelativeLayout>
