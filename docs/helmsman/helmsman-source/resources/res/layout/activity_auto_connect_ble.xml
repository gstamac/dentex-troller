<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/activity_auto_connect_ble"
    android:fitsSystemWindows="true"
    android:clipToPadding="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="5dp">
        <im.helmsman.helmsmanandroid.view.TitleBar
            android:id="@+id/titleBar"
            android:background="@color/title_red"
            android:layout_width="match_parent"
            android:layout_height="168px"
            app:left_drawable="0x7f0701db"
            app:textColor="@color/white"
            app:title="HMXXXX"/>
    </FrameLayout>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="253px"
        android:layout_marginTop="24px">
        <ImageView
            android:layout_width="70px"
            android:layout_height="70px"
            android:layout_margin="48px"
            android:src="0x7f07023c"
            android:layout_centerVertical="true"/>
        <TextView
            android:textSize="48px"
            android:textColor="@color/black"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="216px"
            android:layout_marginTop="60px"
            android:text="@string/primary_device"/>
        <TextView
            android:textSize="42px"
            android:textColor="#999999"
            android:layout_width="613px"
            android:layout_height="wrap_content"
            android:layout_marginLeft="216px"
            android:layout_marginTop="160px"
            android:layout_marginRight="48px"
            android:text="@string/auto_connect_hint"/>
        <Switch
            android:id="@+id/switch_check_auto_connect"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="48px"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/rel_search_wifi"
        android:layout_width="match_parent"
        android:layout_height="163px"
        android:layout_marginTop="24px">
        <ImageView
            android:layout_width="70px"
            android:layout_height="70px"
            android:layout_margin="48px"
            android:src="0x7f070236"
            android:layout_centerVertical="true"/>
        <TextView
            android:textSize="48px"
            android:textColor="@color/black"
            android:layout_width="635px"
            android:layout_height="wrap_content"
            android:layout_marginLeft="216px"
            android:text="@string/search_trolling_motor"
            android:layout_centerVertical="true"/>
        <ImageView
            android:layout_width="22px"
            android:layout_height="wrap_content"
            android:layout_marginRight="48px"
            android:src="@drawable/icon_accessory_arrow"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/rel_alias_bluetooth"
        android:layout_width="match_parent"
        android:layout_height="163px"
        android:layout_marginTop="24px">
        <ImageView
            android:layout_width="70px"
            android:layout_height="70px"
            android:layout_margin="48px"
            android:src="0x7f0701da"
            android:layout_centerVertical="true"/>
        <TextView
            android:textSize="48px"
            android:textColor="@color/black"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="216px"
            android:text="@string/blebluetooth_alias_name"
            android:layout_centerVertical="true"/>
        <ImageView
            android:layout_width="22px"
            android:layout_height="wrap_content"
            android:layout_marginRight="48px"
            android:src="@drawable/icon_accessory_arrow"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
</LinearLayout>
