<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:background="#ff4a49"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_weight="5"
        android:elevation="5dp">
        <RelativeLayout
            android:background="#ff4a49"
            android:fitsSystemWindows="true"
            android:clipToPadding="true"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <im.helmsman.helmsmanandroid.view.TitleBar
                android:id="@+id/titlebar"
                android:layout_width="match_parent"
                android:layout_height="168px"
                app:textColor="@color/white"
                app:title="@string/remote_control">
                <ImageView
                    android:id="@+id/iv_ble_connect_delete"
                    android:visibility="gone"
                    android:layout_width="42px"
                    android:layout_height="54px"
                    android:layout_marginRight="48px"
                    android:src="0x7f0701f0"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"/>
                <ImageButton
                    android:id="@+id/ib_back"
                    android:background="@android:color/transparent"
                    android:padding="5dp"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_marginLeft="16dp"
                    android:layout_marginTop="16dp"
                    android:src="0x7f0701db"
                    android:scaleType="fitXY"/>
            </im.helmsman.helmsmanandroid.view.TitleBar>
            <RelativeLayout
                android:id="@+id/rel_blebluetooth_permission"
                android:background="#ca3d3e"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="168px">
                <ImageView
                    android:id="@+id/iv_jump"
                    android:layout_width="23px"
                    android:layout_height="36px"
                    android:layout_marginRight="48px"
                    android:src="0x7f07025d"
                    android:layout_centerVertical="true"
                    android:layout_alignParentEnd="true"/>
                <TextView
                    android:textSize="48px"
                    android:textColor="@android:color/white"
                    android:gravity="center"
                    android:id="@+id/tv_blebluetooth_permission_miss_hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="50px"
                    android:layout_marginRight="50px"
                    android:text="@string/Please_turn_on_bluetooth"
                    android:layout_toLeftOf="@+id/iv_jump"
                    android:layout_centerVertical="true"/>
            </RelativeLayout>
            <ImageView
                android:layout_width="532px"
                android:layout_height="532px"
                android:layout_marginTop="300px"
                android:src="0x7f070274"
                android:layout_centerHorizontal="true"/>
            <ImageView
                android:id="@+id/iv_ble_bluetooth_swipeing"
                android:layout_width="576px"
                android:layout_height="576px"
                android:layout_marginTop="280px"
                android:src="0x7f070293"
                android:layout_centerHorizontal="true"/>
            <TextView
                android:textSize="150px"
                android:textColor="@android:color/white"
                android:id="@+id/tv_ble_bluetooth_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="500px"
                android:text="6"
                android:layout_centerHorizontal="true"/>
        </RelativeLayout>
    </FrameLayout>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="6">
        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipe_ble_bluetooth"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ListView
                android:id="@+id/lv_ble_bluetooth"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
    </RelativeLayout>
</LinearLayout>
