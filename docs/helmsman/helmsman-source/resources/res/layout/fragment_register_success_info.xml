<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="642px"
    android:layout_height="342px">
    <TextView
        android:textSize="60px"
        android:textColor="@android:color/holo_red_light"
        android:padding="29px"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="227px"
        android:text="CONGRATULATIONS!"/>
    <View
        android:background="@android:color/holo_red_light"
        android:layout_width="match_parent"
        android:layout_height="4px"/>
    <TextView
        android:textSize="48px"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="29px"
        android:text="You have successfully completed the registration."/>
    <Button
        android:textSize="42px"
        android:id="@+id/btn_registersuccess_ok"
        android:background="@android:color/transparent"
        android:layout_width="match_parent"
        android:layout_height="92px"
        android:text="OK"/>
</LinearLayout>
