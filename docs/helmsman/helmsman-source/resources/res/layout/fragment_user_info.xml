<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/rel_user_info"
    android:background="@android:color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="5dp">
        <im.helmsman.helmsmanandroid.view.TitleBar
            android:id="@+id/titleBar"
            android:background="@color/title_red"
            android:layout_width="match_parent"
            android:layout_height="168px"
            app:left_drawable="0x7f0701db"
            app:right_drawable="0x7f07025c"
            app:right_icon_height="60px"
            app:right_icon_width="60px"
            app:textColor="@color/white"
            app:title="@string/fansfragment_profile"/>
    </FrameLayout>
    <im.helmsman.helmsmanandroid.view.OverScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/lin_user_info_overscroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <de.hdodenhof.circleimageview.CircleImageView
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/civ_user_info"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="56dp"
                    android:src="0x7f0701cc"
                    app:civ_border_color="#9b9b9b"
                    app:civ_border_width="2dp"/>
                <RelativeLayout
                    android:layout_gravity="bottom"
                    android:layout_width="match_parent"
                    android:layout_height="180px"
                    android:layout_marginTop="200px">
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/lin_user_info_route"
                        android:paddingTop="16dp"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_marginLeft="48dp"
                        android:layout_alignParentLeft="true"
                        android:layout_centerVertical="true">
                        <TextView
                            android:layout_gravity="center"
                            android:id="@+id/tv_user_info_route_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"/>
                        <TextView
                            android:layout_gravity="center_vertical"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginRight="2dp"
                            android:text="@string/userinfofragment_route"/>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/lin_user_info_following"
                        android:paddingTop="16dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true">
                        <TextView
                            android:layout_gravity="center"
                            android:id="@+id/tv_user_info_following_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginRight="2dp"
                            android:text="@string/userinfofragment_follow"/>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/lin_user_info_follower"
                        android:paddingTop="16dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="48dp"
                        android:layout_alignParentRight="true"
                        android:layout_centerVertical="true">
                        <TextView
                            android:layout_gravity="center"
                            android:id="@+id/tv_user_info_follower_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginRight="2dp"
                            android:text="@string/fansfragment_followers"/>
                    </LinearLayout>
                </RelativeLayout>
            </FrameLayout>
            <FrameLayout
                android:id="@+id/frame_user_info_qrcode"
                android:background="@drawable/ripple_bg"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="32dp">
                <TextView
                    android:gravity="center_vertical"
                    android:layout_gravity="center_vertical"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="@string/userinfofragment_qrcode"/>
                <ImageView
                    android:layout_gravity="center"
                    android:layout_width="@dimen/item_arrow_size"
                    android:layout_height="@dimen/item_arrow_size"
                    android:layout_marginRight="16dp"
                    android:src="@drawable/icon_accessory_arrow"/>
                <View
                    android:layout_gravity="bottom"
                    android:background="@color/itemlist"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginLeft="16dp"/>
            </FrameLayout>
            <RelativeLayout
                android:id="@+id/rel_user_info_user"
                android:background="@drawable/ripple_bg"
                android:layout_width="match_parent"
                android:layout_height="@dimen/item_height">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentLeft="true"
                    android:layout_centerVertical="true">
                    <TextView
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:layout_width="80dp"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="16dp"
                        android:text="@string/userinfofragment_username"
                        android:layout_centerVertical="true"/>
                    <TextView
                        android:textColor="@color/black"
                        android:id="@+id/tv_user_info_user"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
                <ImageView
                    android:layout_width="@dimen/item_arrow_size"
                    android:layout_height="@dimen/item_arrow_size"
                    android:layout_marginRight="16dp"
                    android:src="@drawable/icon_accessory_arrow"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"/>
                <View
                    android:background="@color/itemlist"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginLeft="16dp"
                    android:layout_alignParentBottom="true"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/rel_user_info_gender"
                android:background="@drawable/ripple_bg"
                android:layout_width="match_parent"
                android:layout_height="@dimen/item_height">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentLeft="true"
                    android:layout_centerVertical="true">
                    <TextView
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:layout_width="80dp"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="16dp"
                        android:text="@string/userinfofragment_gender"
                        android:layout_centerVertical="true"/>
                    <TextView
                        android:textColor="@color/black"
                        android:id="@+id/tv_user_info_gender"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="8dp"/>
                </LinearLayout>
                <ImageView
                    android:layout_width="@dimen/item_arrow_size"
                    android:layout_height="@dimen/item_arrow_size"
                    android:layout_marginRight="16dp"
                    android:src="@drawable/icon_accessory_arrow"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"/>
                <View
                    android:background="@color/itemlist"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginLeft="16dp"
                    android:layout_alignParentBottom="true"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/rel_user_info_country"
                android:background="@drawable/ripple_bg"
                android:layout_width="match_parent"
                android:layout_height="@dimen/item_height">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentLeft="true"
                    android:layout_centerVertical="true">
                    <TextView
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:layout_width="80dp"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="16dp"
                        android:text="@string/host_country"
                        android:layout_centerVertical="true"/>
                    <TextView
                        android:textColor="@color/black"
                        android:id="@+id/tv_user_info_country"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="8dp"/>
                </LinearLayout>
                <ImageView
                    android:layout_width="@dimen/item_arrow_size"
                    android:layout_height="@dimen/item_arrow_size"
                    android:layout_marginRight="16dp"
                    android:src="@drawable/icon_accessory_arrow"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"/>
                <View
                    android:background="@color/itemlist"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginLeft="16dp"
                    android:layout_alignParentBottom="true"/>
            </RelativeLayout>
            <RelativeLayout
                android:orientation="horizontal"
                android:id="@+id/rel_user_info_instruction"
                android:background="@drawable/ripple_bg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:gravity="center_vertical"
                    android:id="@+id/tv_user_info_instruction"
                    android:layout_width="80dp"
                    android:layout_height="@dimen/item_height"
                    android:layout_marginLeft="16dp"
                    android:text="@string/userinfofragment_intro"
                    android:minEms="1"/>
                <TextView
                    android:textColor="@color/black"
                    android:gravity="center_vertical"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/tv_user_info_instruction_content"
                    android:paddingTop="8dp"
                    android:paddingRight="8dp"
                    android:paddingBottom="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toLeftOf="@+id/iv_user_info_instrucion_arrow"
                    android:layout_toRightOf="@+id/tv_user_info_instruction"
                    android:layout_centerVertical="true"/>
                <ImageView
                    android:id="@+id/iv_user_info_instrucion_arrow"
                    android:layout_width="@dimen/item_arrow_size"
                    android:layout_height="@dimen/item_arrow_size"
                    android:layout_marginRight="16dp"
                    android:src="@drawable/icon_accessory_arrow"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"/>
            </RelativeLayout>
            <View
                android:background="@color/itemlist"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginLeft="16dp"
                android:layout_alignParentBottom="true"/>
            <FrameLayout
                android:id="@+id/fragment_changepassword"
                android:background="@drawable/ripple_bg"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="32dp">
                <TextView
                    android:gravity="center_vertical"
                    android:layout_gravity="center_vertical"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="@string/account_securiyt"/>
                <ImageView
                    android:layout_gravity="center"
                    android:layout_width="@dimen/item_arrow_size"
                    android:layout_height="@dimen/item_arrow_size"
                    android:layout_marginRight="16dp"
                    android:src="@drawable/icon_accessory_arrow"/>
            </FrameLayout>
            <View
                android:background="@color/itemlist"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginLeft="16dp"
                android:layout_alignParentBottom="true"/>
            <FrameLayout
                android:id="@+id/fragment_natifiction"
                android:background="@drawable/ripple_bg"
                android:layout_width="match_parent"
                android:layout_height="48dp">
                <TextView
                    android:gravity="center_vertical"
                    android:layout_gravity="center_vertical"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="@string/notification_item"/>
                <ImageView
                    android:layout_gravity="center"
                    android:layout_width="@dimen/item_arrow_size"
                    android:layout_height="@dimen/item_arrow_size"
                    android:layout_marginRight="16dp"
                    android:src="@drawable/icon_accessory_arrow"/>
            </FrameLayout>
            <View
                android:background="@color/itemlist"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginLeft="16dp"
                android:layout_alignParentBottom="true"/>
            <Button
                android:textColor="@color/main_red"
                android:layout_gravity="center"
                android:id="@+id/btn_user_info_logout"
                android:background="@drawable/ripple_bg"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="32dp"
                android:text="@string/userinfofragment_logout"
                android:layout_alignParentBottom="true"
                style="@null"/>
        </LinearLayout>
    </im.helmsman.helmsmanandroid.view.OverScrollView>
</LinearLayout>
