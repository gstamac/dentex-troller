<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/activity_edit_new_user_info"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/cardview"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="5dp">
        <im.helmsman.helmsmanandroid.view.TitleBar
            android:id="@+id/titleBar"
            android:background="@color/title_red"
            android:layout_width="match_parent"
            android:layout_height="168px"
            app:left_drawable="0x7f0701db"
            app:textColor="@color/white"
            app:title="@string/fansfragment_profile">
            <ImageView
                android:id="@+id/iv_edit_new_userinfo_tick"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginRight="19dp"
                android:src="0x7f070250"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"/>
        </im.helmsman.helmsmanandroid.view.TitleBar>
    </FrameLayout>
    <de.hdodenhof.circleimageview.CircleImageView
        android:id="@+id/civ_profile_avatar"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginTop="40dp"
        android:src="0x7f07029e"
        android:layout_below="@+id/cardview"
        android:layout_centerHorizontal="true"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:layout_below="@+id/civ_profile_avatar">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="48dp">
            <ImageView
                android:id="@+id/iv_email_icon"
                android:layout_width="20dp"
                android:layout_height="16dp"
                android:layout_marginLeft="16dp"
                android:src="0x7f0701fa"
                android:layout_centerVertical="true"/>
            <EditText
                android:textSize="16sp"
                android:textColorHint="#42000000"
                android:id="@+id/iv_edit_new_userinfo_email"
                android:layout_width="272dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="36dp"
                android:hint="@string/email"
                android:layout_toRightOf="@+id/iv_email_icon"/>
        </RelativeLayout>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="48dp">
            <ImageView
                android:id="@+id/iv_user_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginLeft="16dp"
                android:src="0x7f070254"
                android:layout_centerVertical="true"/>
            <EditText
                android:textSize="16sp"
                android:textColorHint="#42000000"
                android:id="@+id/iv_edit_new_userinfo_nickname"
                android:layout_width="272dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="36dp"
                android:hint="@string/nickname"
                android:layout_toRightOf="@+id/iv_user_icon"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/rel_edit_new_userinfo_sex"
            android:layout_width="match_parent"
            android:layout_height="48dp">
            <ImageView
                android:id="@+id/iv_male_icon"
                android:layout_width="20dp"
                android:layout_height="19dp"
                android:layout_marginLeft="16dp"
                android:src="0x7f070223"
                android:layout_centerVertical="true"/>
            <EditText
                android:textSize="16sp"
                android:textColorHint="#42000000"
                android:id="@+id/et_edit_new_userinfo_sex"
                android:focusable="false"
                android:layout_width="272dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="36dp"
                android:hint="@string/male"
                android:editable="false"
                android:layout_toRightOf="@+id/iv_male_icon"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/rel_edit_new_userinfo_contry"
            android:layout_width="match_parent"
            android:layout_height="48dp">
            <ImageView
                android:id="@+id/iv_contry_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginLeft="16dp"
                android:src="0x7f0701eb"
                android:layout_centerVertical="true"/>
            <EditText
                android:textSize="16sp"
                android:textColorHint="#42000000"
                android:id="@+id/et_edit_new_userinfo_contry"
                android:focusable="false"
                android:layout_width="272dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="36dp"
                android:hint="@string/contry"
                android:editable="false"
                android:layout_toRightOf="@+id/iv_contry_icon"/>
        </RelativeLayout>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="48dp">
            <ImageView
                android:id="@+id/iv_description_icon"
                android:layout_width="20dp"
                android:layout_height="18dp"
                android:layout_marginLeft="16dp"
                android:src="0x7f0701f1"
                android:layout_centerVertical="true"/>
            <EditText
                android:textSize="16sp"
                android:textColorHint="#42000000"
                android:id="@+id/iv_edit_new_userinfo_description"
                android:layout_width="272dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="36dp"
                android:hint="@string/contact_fragment_description_hint"
                android:layout_toRightOf="@+id/iv_description_icon"/>
        </RelativeLayout>
    </LinearLayout>
</RelativeLayout>
