<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/ripple_bg"
    android:layout_width="match_parent"
    android:layout_height="160px">
    <TextView
        android:textSize="42px"
        android:gravity="center_vertical"
        android:id="@+id/tv_item_mydevices"
        android:padding="50px"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="My Devices"
        android:layout_centerVertical="true"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="80dp">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="48px"
                android:textColor="#a1a1a1"
                android:layout_gravity="center_vertical"
                android:id="@+id/tv_item_bluebooth_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="48px"/>
            <TextView
                android:textSize="48px"
                android:textColor="#a1a1a1"
                android:layout_gravity="center_vertical"
                android:id="@+id/tv_item_state"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="48px"
                android:layout_marginTop="8px"
                android:text="@string/blebluetooth_connect_notconnected"/>
        </LinearLayout>
        <TextView
            android:textSize="48px"
            android:layout_gravity="center_vertical"
            android:id="@+id/tv_item_bluebooth_address"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"/>
    </LinearLayout>
    <ImageView
        android:id="@+id/iv_item_bluetooth_correct"
        android:visibility="gone"
        android:layout_width="22px"
        android:layout_height="36px"
        android:layout_marginRight="50px"
        android:src="0x7f0701e1"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"/>
    <CheckBox
        android:enabled="false"
        android:id="@+id/cb_ble_connect_delete"
        android:focusable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="58px"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"/>
</RelativeLayout>
