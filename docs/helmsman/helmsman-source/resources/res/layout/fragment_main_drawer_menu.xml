<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/linear_left_drawer_layout"
    android:background="@android:color/black"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/layout_loginblock"
        layout="@layout/include_loginbutton"/>
    <include
        android:id="@+id/layout_userinfoblock"
        layout="@layout/include_userinfo"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rec_drawer_menu_list"
        android:paddingTop="100px"
        android:layout_width="match_parent"
        android:layout_height="872px"/>
</LinearLayout>
