<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <im.helmsman.helmsmanandroid.view.CycleBanner
        android:id="@+id/cyclebanner"
        android:layout_width="match_parent"
        android:layout_height="1080px"/>
    <ImageView
        android:id="@+id/iv_commodity_detail_back"
        android:layout_width="73px"
        android:layout_height="73px"
        android:layout_margin="50px"
        android:src="0x7f0701e6"
        android:scaleType="fitXY"
        app:layout_auto_basewidth="height"/>
    <RelativeLayout
        android:layout_gravity="bottom"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="170px">
        <Button
            android:textSize="42px"
            android:textColor="@color/white"
            android:id="@+id/btn_commodity_buy"
            android:background="@drawable/buy_commodity_selector"
            android:layout_width="400px"
            android:layout_height="100px"
            android:text="@string/buy_now"
            android:layout_centerInParent="true"/>
        <Button
            android:id="@+id/btn_commodity_share"
            android:background="0x7f07024d"
            android:layout_width="70px"
            android:layout_height="70px"
            android:layout_margin="50px"
            android:layout_alignParentRight="true"
            android:layout_alignParentBottom="true"/>
    </RelativeLayout>
</FrameLayout>
