<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:paddingLeft="16dp"
    android:paddingTop="8dp"
    android:paddingRight="16dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <EditText
                android:textSize="18sp"
                android:id="@+id/et_regist_mail"
                android:focusable="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/email"
                android:singleLine="true"
                android:inputType="textEmailAddress"/>
        </com.google.android.material.textfield.TextInputLayout>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/iv_regist_mail_dismiss"
            android:padding="8dp"
            android:visibility="gone"
            android:layout_width="32dp"
            android:layout_height="32dp"/>
    </FrameLayout>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <EditText
                android:textSize="18sp"
                android:id="@+id/et_regist_pwd"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/password_not_less_than_8"
                android:inputType="textPassword"/>
        </com.google.android.material.textfield.TextInputLayout>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/iv_regist_pwd_dismiss"
            android:padding="8dp"
            android:visibility="gone"
            android:layout_width="32dp"
            android:layout_height="32dp"/>
    </FrameLayout>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <EditText
                android:textSize="18sp"
                android:id="@+id/et_regist_confirm_pwd"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/confirm_password"
                android:inputType="textPassword"/>
        </com.google.android.material.textfield.TextInputLayout>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/iv_regist_confirm_pwd_dismiss"
            android:padding="8dp"
            android:visibility="gone"
            android:layout_width="32dp"
            android:layout_height="32dp"/>
    </FrameLayout>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <EditText
                android:textSize="18sp"
                android:id="@+id/et_regist_user"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/username_limit"
                android:singleLine="true"/>
        </com.google.android.material.textfield.TextInputLayout>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/iv_regist_user_dismiss"
            android:padding="8dp"
            android:visibility="gone"
            android:layout_width="32dp"
            android:layout_height="32dp"/>
    </FrameLayout>
    <Button
        android:enabled="false"
        android:textSize="16sp"
        android:layout_gravity="right"
        android:id="@+id/btn_dialog_finish"
        android:background="@null"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/complete"/>
</LinearLayout>
