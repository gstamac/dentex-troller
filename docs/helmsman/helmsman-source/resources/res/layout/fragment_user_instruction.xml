<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="48dp">
        <RelativeLayout
            android:id="@+id/rel_my_instruction_dismiss"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_centerVertical="true">
            <ImageView
                android:id="@+id/iv_account_close"
                android:layout_width="16dp"
                android:layout_height="24dp"
                android:layout_marginLeft="16dp"
                android:src="@drawable/icon_instruction_dismiss"
                android:layout_centerVertical="true"/>
            <TextView
                android:textSize="@dimen/setting_title_dismiss_size"
                android:textColor="@color/main_red"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:text="@string/profile"
                android:layout_toRightOf="@+id/iv_account_close"
                android:layout_centerVertical="true"/>
        </RelativeLayout>
        <FrameLayout
            android:background="@color/gray_lite"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_alignParentBottom="true"/>
        <TextView
            android:textSize="@dimen/setting_title_text_size"
            android:textColor="@color/black"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/profile"
            android:layout_centerInParent="true"/>
        <Button
            android:enabled="false"
            android:textSize="18sp"
            android:id="@+id/btn_my_instruction_finish"
            android:background="@null"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/edit_done"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
    <EditText
        android:textSize="16sp"
        android:gravity="top"
        android:layout_gravity="top"
        android:id="@+id/tv_account_instruction_content"
        android:background="@null"
        android:padding="16dp"
        android:focusable="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:hint="@string/userinfofragment_descrpbe"
        android:maxLength="150"/>
</LinearLayout>
