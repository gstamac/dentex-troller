<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/activity_at_friends"
    android:fitsSystemWindows="true"
    android:clipToPadding="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="5dp">
        <im.helmsman.helmsmanandroid.view.TitleBar
            android:id="@+id/titleBar"
            android:background="@color/title_red"
            android:layout_width="match_parent"
            android:layout_height="168px"
            app:left_drawable="0x7f0701db"
            app:textColor="@color/white"
            app:title="@string/contact">
            <ImageView
                android:id="@+id/iv_search"
                android:padding="10px"
                android:layout_width="90px"
                android:layout_height="90px"
                android:layout_marginRight="50px"
                android:src="0x7f070246"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"/>
            <im.helmsman.helmsmanandroid.view.SearchView
                android:id="@+id/sv_search_contact"
                android:visibility="gone"
                android:layout_width="800px"
                android:layout_height="wrap_content"
                android:layout_marginLeft="176px"
                android:layout_centerVertical="true"/>
        </im.helmsman.helmsmanandroid.view.TitleBar>
    </FrameLayout>
    <ListView
        android:id="@+id/lv_atfriend_contact_list"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="168px"
        android:divider="@null"/>
    <im.helmsman.helmsmanandroid.view.WaveSideBar
        android:id="@+id/wsb_at_friend_sidebar"
        android:paddingRight="8dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="175px"
        app:sidebar_max_offset="0dp"
        app:sidebar_text_color="@color/black"/>
</RelativeLayout>
