<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/white"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <im.helmsman.helmsmanandroid.view.TitleBar
        android:id="@+id/titleBar"
        android:background="@android:color/white"
        android:layout_width="match_parent"
        android:layout_height="168px"
        app:title="@string/setting_navi_mode"/>
    <RadioGroup
        android:gravity="center_horizontal"
        android:id="@+id/rg_mode_selection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="60dp">
        <RadioButton
            android:textSize="@dimen/setting_title_text_size"
            android:id="@+id/rb_standard_mode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/navimode_standard_mode"/>
        <RadioButton
            android:textSize="@dimen/setting_title_text_size"
            android:id="@+id/rb_accurate_mode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/navimode_accurate_mode"/>
    </RadioGroup>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="15dp"
        android:layout_marginTop="30dp"
        android:layout_marginRight="15dp"
        android:layout_below="@+id/rg_mode_selection">
        <TextView
            android:id="@+id/tv_navi_mode_description"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="15dp"/>
    </LinearLayout>
    <RelativeLayout
        android:layout_gravity="center_horizontal"
        android:id="@+id/rel_navi_mode_save"
        android:background="@drawable/bg_calibration_start"
        android:layout_width="140dp"
        android:layout_height="38dp"
        android:layout_marginTop="30dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true">
        <TextView
            android:textSize="@dimen/edit_route_dis_size"
            android:textColor="@color/main_red"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/addroute_save"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
</LinearLayout>
