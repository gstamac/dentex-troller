<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/white"
    android:fitsSystemWindows="true"
    android:clipToPadding="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="5dp">
        <im.helmsman.helmsmanandroid.view.TitleBar
            android:id="@+id/titleBar"
            android:background="@color/title_red"
            android:layout_width="match_parent"
            android:layout_height="168px"
            app:left_drawable="0x7f0701db"
            app:textColor="@color/white"
            app:title="@string/headingcallbration_calibration"/>
    </FrameLayout>
    <ImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/iv_gif"
        android:layout_width="290dp"
        android:layout_height="290dp"
        android:layout_marginTop="16dp"/>
    <FrameLayout
        android:id="@+id/frame_heading_calibration_top"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <androidx.cardview.widget.CardView
        android:layout_gravity="center_horizontal"
        android:layout_width="167dp"
        android:layout_height="40dp"
        android:layout_marginTop="62dp"
        app:cardCornerRadius="1dp"
        app:cardElevation="20px">
        <Button
            android:textSize="48px"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/btn_calibration_start"
            android:background="@color/title_red"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="START"/>
    </androidx.cardview.widget.CardView>
</LinearLayout>
