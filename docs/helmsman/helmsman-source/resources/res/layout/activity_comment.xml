<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/parent"
    android:fitsSystemWindows="true"
    android:clipToPadding="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <im.helmsman.helmsmanandroid.view.TitleBar
        android:id="@+id/titleBar"
        android:background="@color/title_red"
        android:layout_width="match_parent"
        android:layout_height="168px"
        app:left_drawable="0x7f0701db"
        app:textColor="@color/white"
        app:title="@string/comment_title">
        <ImageView
            android:id="@+id/iv_comment_tick"
            android:visibility="gone"
            android:layout_width="48px"
            android:layout_height="48px"
            android:layout_marginRight="61px"
            android:src="0x7f070250"
            android:scaleType="centerCrop"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"/>
    </im.helmsman.helmsmanandroid.view.TitleBar>
    <EditText
        android:id="@+id/et_comment_comment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="48px"
        android:layout_marginRight="48px"
        android:hint="write comment..."/>
</LinearLayout>
