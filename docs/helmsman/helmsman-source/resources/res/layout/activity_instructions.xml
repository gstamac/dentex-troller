<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/setting_bg"
    android:fitsSystemWindows="true"
    android:clipToPadding="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="5dp">
        <im.helmsman.helmsmanandroid.view.TitleBar
            android:id="@+id/titleBar"
            android:background="@color/title_red"
            android:layout_width="match_parent"
            android:layout_height="168px"
            app:left_drawable="0x7f0701db"
            app:textColor="@color/white"
            app:title="@string/setting_help"/>
    </FrameLayout>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <im.helmsman.helmsmanandroid.view.OverScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/lin_instruction_overscroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="24px">
                <RelativeLayout
                    android:id="@+id/rel_instruction_quick_start"
                    android:background="@drawable/ripple_bg"
                    android:layout_width="match_parent"
                    android:layout_height="145px">
                    <ImageView
                        android:id="@+id/iv_instructions_quick_start"
                        android:layout_width="@dimen/item_icon_size"
                        android:layout_height="@dimen/item_icon_size"
                        android:layout_marginLeft="16dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginRight="8dp"
                        android:layout_marginBottom="8dp"
                        android:src="@drawable/icon_instruction_quick_start"
                        android:layout_centerVertical="true"/>
                    <TextView
                        android:textSize="48px"
                        android:textColor="@color/black"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="8dp"
                        android:text="@string/instruction_quick_start"
                        android:layout_toRightOf="@+id/iv_instructions_quick_start"
                        android:layout_centerVertical="true"/>
                </RelativeLayout>
                <RelativeLayout
                    android:id="@+id/rel_instruction_college"
                    android:background="@drawable/ripple_bg"
                    android:layout_width="match_parent"
                    android:layout_height="145px">
                    <ImageView
                        android:id="@+id/iv_instructions_college"
                        android:layout_width="@dimen/item_icon_size"
                        android:layout_height="@dimen/item_icon_size"
                        android:layout_marginLeft="16dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginRight="8dp"
                        android:layout_marginBottom="8dp"
                        android:src="0x7f070263"
                        android:layout_centerVertical="true"/>
                    <TextView
                        android:textSize="48px"
                        android:textColor="@color/black"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="8dp"
                        android:text="@string/instruction_helmsman_clooege"
                        android:layout_toRightOf="@+id/iv_instructions_college"
                        android:layout_centerVertical="true"/>
                </RelativeLayout>
                <RelativeLayout
                    android:id="@+id/rel_instruction_manuals"
                    android:background="@drawable/ripple_bg"
                    android:layout_width="match_parent"
                    android:layout_height="145px">
                    <ImageView
                        android:id="@+id/iv_instructions_manuals"
                        android:layout_width="@dimen/item_icon_size"
                        android:layout_height="@dimen/item_icon_size"
                        android:layout_marginLeft="16dp"
                        android:src="0x7f070224"
                        android:layout_centerVertical="true"/>
                    <TextView
                        android:textSize="48px"
                        android:textColor="@color/black"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="16dp"
                        android:text="@string/instruction_manual"
                        android:layout_toRightOf="@+id/iv_instructions_manuals"
                        android:layout_centerVertical="true"/>
                </RelativeLayout>
                <RelativeLayout
                    android:id="@+id/rel_instruction_customer_service"
                    android:background="@drawable/ripple_bg"
                    android:layout_width="match_parent"
                    android:layout_height="145px">
                    <ImageView
                        android:id="@+id/iv_instructions_mobil"
                        android:layout_width="@dimen/item_icon_size"
                        android:layout_height="@dimen/item_icon_size"
                        android:layout_marginLeft="16dp"
                        android:src="0x7f0701ed"
                        android:layout_centerVertical="true"/>
                    <TextView
                        android:textSize="48px"
                        android:textColor="@color/black"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="16dp"
                        android:text="@string/instruction_customer_service"
                        android:layout_toRightOf="@+id/iv_instructions_mobil"
                        android:layout_centerVertical="true"/>
                </RelativeLayout>
            </LinearLayout>
        </im.helmsman.helmsmanandroid.view.OverScrollView>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/com_facebook_blue"
            android:autoLink="all"
            android:id="@+id/tv_private_policy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/private_policy"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"/>
    </RelativeLayout>
</LinearLayout>
