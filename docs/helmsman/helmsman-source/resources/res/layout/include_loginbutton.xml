<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="#4a4a4a"
    android:layout_width="match_parent"
    android:layout_height="833px">
    <ImageView
        android:layout_width="568px"
        android:layout_height="84px"
        android:layout_marginTop="82px"
        android:src="@drawable/icon_helmsman_text"
        android:layout_centerHorizontal="true"/>
    <Button
        android:textColor="@android:color/white"
        android:id="@+id/btn_drawer_login"
        android:background="@android:color/holo_red_dark"
        android:layout_width="490px"
        android:layout_height="88px"
        android:layout_marginTop="214px"
        android:text="@string/signin"
        android:layout_centerHorizontal="true"/>
    <ImageView
        android:layout_width="490px"
        android:layout_height="58px"
        android:layout_marginTop="332px"
        android:src="@drawable/icon_or_linear"
        android:layout_centerHorizontal="true"/>
    <Button
        android:textColor="@android:color/white"
        android:id="@+id/btn_drawer_register"
        android:background="#7ed321"
        android:layout_width="490px"
        android:layout_height="88px"
        android:layout_marginTop="420px"
        android:text="@string/signup"
        android:layout_centerHorizontal="true"/>
    <com.facebook.login.widget.LoginButton
        android:id="@+id/iv_drawer_facebook_login"
        android:visibility="gone"
        android:layout_width="120px"
        android:layout_height="120px"
        android:layout_marginLeft="182px"
        android:layout_marginTop="631px"
        android:src="0x7f0701fc"/>
    <ImageView
        android:id="@+id/iv_drawer_facebook_login_button"
        android:layout_width="120px"
        android:layout_height="120px"
        android:layout_marginLeft="182px"
        android:layout_marginTop="631px"
        android:src="0x7f0701fc"/>
    <ImageView
        android:id="@+id/iv_drawer_weixin_login"
        android:layout_width="120px"
        android:layout_height="120px"
        android:layout_marginLeft="462px"
        android:layout_marginTop="631px"
        android:src="0x7f07025b"/>
    <TextView
        android:textSize="10sp"
        android:textColor="#d8cecc"
        android:id="@+id/textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="17dp"
        android:text="@string/if_not_register"
        android:layout_below="@+id/btn_drawer_register"
        android:layout_centerHorizontal="true"
        android:alpha="0.7"
        android:allowUndo="false"/>
</RelativeLayout>
