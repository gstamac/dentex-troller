<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:background="@drawable/ripple_bg"
        android:layout_width="match_parent"
        android:layout_height="@dimen/item_height">
        <TextView
            android:id="@+id/tv_itemboatlist_ssid"
            android:padding="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"/>
        <TextView
            android:id="@+id/tv_itemboatlist_connectstate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_toRightOf="@+id/tv_itemboatlist_ssid"
            android:layout_centerVertical="true"/>
        <ImageView
            android:padding="5dp"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/item_arrow_size"
            android:src="@drawable/icon_accessory_arrow"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
</FrameLayout>
