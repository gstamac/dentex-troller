<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="#e5e5e5"
    android:layout_width="468px"
    android:layout_height="468px">
    <ImageView
        android:layout_gravity="center"
        android:layout_width="200px"
        android:layout_height="260px"
        android:src="0x7f070225"/>
    <RelativeLayout
        android:layout_gravity="bottom"
        android:background="#000000"
        android:layout_width="match_parent"
        android:layout_height="144px"
        android:alpha="0.5">
        <TextView
            android:textSize="42px"
            android:textColor="@color/white"
            android:id="@+id/tv_manual_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="48px"
            android:maxWidth="90dp"
            android:text="50736"
            android:maxLines="1"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
    <ImageView
        android:layout_gravity="bottom|right"
        android:id="@+id/iv_manuals_download"
        android:layout_width="72px"
        android:layout_height="72px"
        android:layout_marginRight="48px"
        android:layout_marginBottom="38px"
        android:src="0x7f0701f3"/>
    <ProgressBar
        android:layout_gravity="bottom|right"
        android:id="@+id/pb_manuals"
        android:visibility="gone"
        android:layout_width="30dp"
        android:layout_height="wrap_content"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="12dp"
        android:max="100"
        android:progress="0"
        style="@style/Base.Widget.AppCompat.ProgressBar.Horizontal"/>
</FrameLayout>
