<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/activity_login"
    android:fitsSystemWindows="true"
    android:clipToPadding="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.cardview.widget.CardView
        android:id="@+id/cardview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="0dp"
        app:cardElevation="20px">
        <im.helmsman.helmsmanandroid.view.TitleBar
            android:id="@+id/titleBar"
            android:background="@color/title_red"
            android:layout_width="match_parent"
            android:layout_height="168px"
            app:left_drawable="0x7f0701db"
            app:textColor="@color/white"
            app:title="@string/app_name"/>
    </androidx.cardview.widget.CardView>
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tiet_login_mail"
        android:layout_width="232dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="79dp"
        android:layout_below="@+id/cardview"
        android:layout_centerHorizontal="true">
        <EditText
            android:textColorHint="#1a000000"
            android:id="@+id/et_login_mail"
            android:layout_width="232dp"
            android:layout_height="wrap_content"
            android:hint="@string/email"/>
    </com.google.android.material.textfield.TextInputLayout>
    <ImageView
        android:id="@+id/iv_login_mail_dismiss"
        android:padding="12dp"
        android:visibility="gone"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginRight="60dp"
        android:src="@drawable/icon_login_correct"
        android:layout_alignBottom="@+id/tiet_login_mail"
        android:layout_alignParentRight="true"/>
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tiet_login_password"
        android:layout_width="232dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_below="@+id/tiet_login_mail"
        android:layout_centerHorizontal="true">
        <EditText
            android:textColorHint="#1a000000"
            android:id="@+id/et_login_password"
            android:layout_width="232dp"
            android:layout_height="wrap_content"
            android:hint="@string/password"
            android:inputType="textPassword"/>
    </com.google.android.material.textfield.TextInputLayout>
    <ImageView
        android:padding="8dp"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginRight="63dp"
        android:layout_marginBottom="3dp"
        android:layout_alignTop="@+id/tiet_login_mail"
        android:layout_alignParentRight="true"/>
    <Button
        android:enabled="false"
        android:textSize="42px"
        android:textColor="@color/white"
        android:id="@+id/btn_sinin"
        android:background="#ff4a49"
        android:layout_width="232dp"
        android:layout_height="36dp"
        android:layout_marginTop="20dp"
        android:text="@string/signin"
        android:layout_below="@+id/tiet_login_password"
        android:layout_centerHorizontal="true"
        style="?android:attr/borderlessButtonStyle"/>
    <ImageView
        android:id="@+id/iv_or_line"
        android:layout_width="234dp"
        android:layout_height="20dp"
        android:layout_marginTop="20dp"
        android:src="0x7f070239"
        android:layout_below="@+id/btn_sinin"
        android:layout_centerHorizontal="true"/>
    <Button
        android:textSize="42px"
        android:textColor="@color/white"
        android:id="@+id/btn_sinup"
        android:background="#009688"
        android:layout_width="232dp"
        android:layout_height="36dp"
        android:layout_marginTop="20dp"
        android:text="@string/signup"
        android:layout_below="@+id/iv_or_line"
        android:layout_centerHorizontal="true"
        style="?android:attr/borderlessButtonStyle"/>
    <TextView
        android:textSize="42px"
        android:textColor="#a3a3a3"
        android:id="@+id/tv_if_not_account"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:text="@string/if_not_account"
        android:layout_below="@+id/btn_sinup"
        android:layout_centerHorizontal="true"/>
    <ImageView
        android:id="@+id/iv_facebook_login"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginLeft="111dp"
        android:layout_marginTop="30dp"
        android:src="0x7f0701fc"
        android:layout_below="@+id/tv_if_not_account"/>
    <ImageView
        android:id="@+id/iv_weixin_login"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="30dp"
        android:layout_marginRight="111dp"
        android:src="0x7f07025b"
        android:layout_below="@+id/tv_if_not_account"
        android:layout_alignParentRight="true"/>
</RelativeLayout>
