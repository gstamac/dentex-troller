<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="2dp">
    <FrameLayout
        android:background="@drawable/ripple_bg"
        android:layout_width="match_parent"
        android:layout_height="344dp">
        <ImageView
            android:id="@+id/iv_waypoint_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="0x7f07025a"
            android:scaleType="centerInside"
            android:layout_centerInParent="true"/>
        <RelativeLayout
            android:layout_gravity="bottom"
            android:background="#80424242"
            android:layout_width="match_parent"
            android:layout_height="495px">
            <TextView
                android:textSize="42px"
                android:textColor="@color/white"
                android:id="@+id/tv_localroute_navi"
                android:paddingTop="24px"
                android:paddingRight="24px"
                android:paddingBottom="24px"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="48px"
                android:layout_marginBottom="24px"
                android:text="@string/NAVI"
                android:layout_alignParentBottom="true"/>
            <TextView
                android:textSize="42px"
                android:textColor="@color/white"
                android:id="@+id/tv_localroute_share"
                android:padding="24px"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="216px"
                android:layout_marginBottom="24px"
                android:text="@string/SHARE"
                android:layout_alignParentBottom="true"/>
            <TextView
                android:textSize="42px"
                android:textColor="@color/white"
                android:id="@+id/tv_localroute_dis"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="48px"
                android:layout_marginTop="235px"
                android:text="11m"/>
            <TextView
                android:textSize="42px"
                android:textColor="@color/white"
                android:id="@+id/tv_item_refresh_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="48px"
                android:layout_marginTop="174px"
                android:text="刚刚"/>
            <TextView
                android:textSize="72px"
                android:textColor="@color/white"
                android:id="@+id/tv_way_point_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="48px"
                android:layout_marginTop="72px"
                android:text="No Name"/>
            <CheckBox
                android:enabled="false"
                android:id="@+id/cb_localroute_check_route"
                android:focusable="false"
                android:clickable="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="48px"
                android:button="@drawable/checkbox_selector"
                android:shadowColor="@color/white"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:scaleX="0.5"
                android:scaleY="0.5"/>
        </RelativeLayout>
    </FrameLayout>
</androidx.cardview.widget.CardView>
