<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/activity_bind_email"
    android:fitsSystemWindows="true"
    android:clipToPadding="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/cardview"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="5dp">
        <im.helmsman.helmsmanandroid.view.TitleBar
            android:id="@+id/titleBar"
            android:background="@color/title_red"
            android:layout_width="match_parent"
            android:layout_height="168px"
            app:left_drawable="0x7f0701db"
            app:textColor="@color/white"
            app:title="@string/account_securiyt_title">
            <ImageView
                android:id="@+id/iv_edit_new_userinfo_tick"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginRight="19dp"
                android:src="0x7f070250"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"/>
        </im.helmsman.helmsmanandroid.view.TitleBar>
    </FrameLayout>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/black"
        android:id="@+id/tv_bindemail_email_address_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="17dp"
        android:text="@string/email_address"
        android:layout_below="@+id/cardview"/>
    <EditText
        android:textColorHint="#d8d8d8"
        android:id="@+id/et_bindemail_email"
        android:layout_width="327dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="7dp"
        android:hint="@string/email"
        android:layout_below="@+id/tv_bindemail_email_address_hint"/>
    <ImageView
        android:id="@+id/iv_green_tick"
        android:layout_width="17.3dp"
        android:layout_height="17.3dp"
        android:layout_marginRight="18dp"
        android:layout_marginBottom="17dp"
        android:src="0x7f070207"
        android:layout_alignBottom="@+id/et_bindemail_email"
        android:layout_alignParentRight="true"/>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="8dp"
        android:text="@string/enter_email"
        android:layout_below="@+id/et_bindemail_email"/>
</RelativeLayout>
