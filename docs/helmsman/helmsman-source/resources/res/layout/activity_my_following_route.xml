<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="5dp">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <im.helmsman.helmsmanandroid.view.TitleBar
                android:id="@+id/titleBar"
                android:background="@color/title_red"
                android:layout_width="match_parent"
                android:layout_height="168px"
                app:left_drawable="0x7f0701db"
                app:textColor="@color/white"
                app:title="@string/local_rote">
                <im.helmsman.helmsmanandroid.view.SearchView
                    android:textColorHint="@color/white"
                    android:id="@+id/search_localroute_search"
                    android:visibility="gone"
                    android:layout_width="220dp"
                    android:layout_height="wrap_content"
                    android:hint="@string/route_search"
                    android:layout_centerInParent="true"
                    app:hint="@string/route_search"/>
                <ImageView
                    android:id="@+id/iv_myfollowing_route_search"
                    android:layout_width="70px"
                    android:layout_height="70px"
                    android:layout_marginRight="48px"
                    android:src="0x7f070246"
                    android:scaleType="fitXY"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"/>
                <ImageView
                    android:id="@+id/iv_myfollowing_route_Message"
                    android:visibility="gone"
                    android:layout_width="52px"
                    android:layout_height="39px"
                    android:layout_marginRight="48px"
                    android:src="0x7f070227"
                    android:scaleType="fitXY"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"/>
                <ImageView
                    android:id="@+id/iv_myfollowing_route_delete"
                    android:padding="15px"
                    android:visibility="gone"
                    android:layout_width="72px"
                    android:layout_height="84px"
                    android:layout_marginRight="48px"
                    android:src="0x7f0701f0"
                    android:scaleType="fitXY"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"/>
                <ImageView
                    android:id="@+id/iv_myfollowing_route_copy"
                    android:padding="15px"
                    android:visibility="gone"
                    android:layout_width="72px"
                    android:layout_height="84px"
                    android:layout_marginRight="178px"
                    android:src="0x7f0701ec"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"/>
                <ImageView
                    android:id="@+id/iv_myfollowing_route_edit"
                    android:padding="15px"
                    android:visibility="gone"
                    android:layout_width="84px"
                    android:layout_height="84px"
                    android:layout_marginRight="288px"
                    android:src="0x7f07020c"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"/>
            </im.helmsman.helmsmanandroid.view.TitleBar>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:background="#ff4a49"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="144px">
                <TextView
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/tv_myfollowing_home"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:text="@string/local_rote"
                    android:layout_weight="1"/>
                <TextView
                    android:textColor="#91ffffff"
                    android:gravity="center"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/tv_myfollowing_MyRoute"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:text="@string/myfollowingrouteactivity_home"
                    android:layout_weight="1"/>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
    <View
        android:id="@+id/view"
        android:background="#49ff7f"
        android:layout_width="540px"
        android:layout_height="6px"/>
    <androidx.viewpager.widget.ViewPager
        android:id="@+id/viepager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</LinearLayout>
