<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.chanven.lib.cptr.PtrClassicFrameLayout
        android:id="@+id/srl_my_following_route"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_my_following_route"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </com.chanven.lib.cptr.PtrClassicFrameLayout>
    <RelativeLayout
        android:layout_gravity="center_horizontal"
        android:id="@+id/rel_trip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="130dp">
        <ImageView
            android:id="@+id/iv_empy_boat"
            android:layout_width="100dp"
            android:layout_height="137dp"
            android:src="0x7f0701e8"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:textSize="48px"
            android:textColor="#4d000000"
            android:id="@+id/tv_no_content_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="50px"
            android:text="@string/no_content_here"
            android:layout_below="@+id/iv_empy_boat"
            android:layout_centerHorizontal="true"/>
        <androidx.cardview.widget.CardView
            android:id="@+id/cardview2"
            android:layout_width="232dp"
            android:layout_height="36dp"
            android:layout_marginTop="70dp"
            android:foreground="?android:attr/selectableItemBackground"
            android:layout_below="@+id/tv_no_content_hint"
            android:layout_centerHorizontal="true"
            app:cardBackgroundColor="#ff4a49"
            app:cardCornerRadius="6px"
            app:cardElevation="20px"
            app:cardMaxElevation="25px">
            <Button
                android:textSize="42px"
                android:textColor="@color/white"
                android:id="@+id/btn_sinin"
                android:background="#ff4a49"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="@string/signin"/>
        </androidx.cardview.widget.CardView>
    </RelativeLayout>
</LinearLayout>
