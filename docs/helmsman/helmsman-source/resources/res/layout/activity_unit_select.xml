<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/cardview"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="5dp">
        <im.helmsman.helmsmanandroid.view.TitleBar
            android:id="@+id/titleBar"
            android:background="@color/title_red"
            android:layout_width="match_parent"
            android:layout_height="168px"
            app:left_drawable="0x7f0701db"
            app:textColor="@color/white"
            app:title="@string/setting_unitconcersion"/>
    </FrameLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/lin_unitconvert_overscroll"
        android:clickable="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/cardview">
        <RelativeLayout
            android:id="@+id/rel_unitconvert_speed"
            android:background="@drawable/bg_setting_item_no_underline"
            android:layout_width="match_parent"
            android:layout_height="72dp">
            <TextView
                android:textSize="16sp"
                android:textColor="#ff000000"
                android:id="@+id/tv_unit_convert_speed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="4.5dp"
                android:text="@string/speed"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#89000000"
                android:id="@+id/tv_speed_unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="KPH"
                android:layout_below="@+id/tv_unit_convert_speed"
                android:layout_alignLeft="@+id/tv_unit_convert_speed"/>
        </RelativeLayout>
        <View
            android:background="#d5d3d3"
            android:layout_width="match_parent"
            android:layout_height="1px"/>
        <RelativeLayout
            android:id="@+id/rel_unitconvert_distance"
            android:background="@drawable/bg_setting_item_no_underline"
            android:layout_width="match_parent"
            android:layout_height="72dp">
            <TextView
                android:textSize="16sp"
                android:textColor="#ff000000"
                android:id="@+id/tv_unit_convert_distance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="4.5dp"
                android:text="@string/distance"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#89000000"
                android:id="@+id/tv_distance_unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="KPH"
                android:layout_below="@+id/tv_unit_convert_distance"
                android:layout_alignLeft="@+id/tv_unit_convert_distance"/>
        </RelativeLayout>
    </LinearLayout>
</RelativeLayout>
