<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:background="@color/black"
        android:layout_width="match_parent"
        android:layout_height="64dp">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="20dp"
            android:textColor="@color/white"
            android:id="@+id/tv_main_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:layout_centerInParent="true"/>
        <ImageView
            android:id="@+id/iv_main_menu"
            android:layout_width="24dp"
            android:layout_height="16dp"
            android:layout_margin="22dp"
            android:src="0x7f0701f4"
            android:layout_centerVertical="true"/>
        <ImageView
            android:id="@+id/iv_main_battery"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginLeft="108dp"
            android:src="@drawable/icon_batterymid"
            android:layout_toRightOf="@+id/tv_main_title"
            android:layout_centerVertical="true"/>
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginLeft="25dp"
            android:src="@drawable/icon_gpssignal_green"
            android:layout_toRightOf="@+id/iv_main_battery"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <fragment
            android:id="@+id/google_map"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            class="com.google.android.gms.maps.MapFragment"/>
        <Button
            android:id="@+id/btn_left"
            android:layout_width="60dp"
            android:layout_height="match_parent"/>
        <Button
            android:layout_gravity="right"
            android:id="@+id/btn_right"
            android:layout_width="60dp"
            android:layout_height="match_parent"/>
        <Button
            android:layout_gravity="bottom|left"
            android:id="@+id/btn_add"
            android:layout_width="158dp"
            android:layout_height="158dp"/>
        <Button
            android:layout_gravity="bottom|right"
            android:id="@+id/btn_jian"
            android:layout_width="158dp"
            android:layout_height="158dp"/>
    </FrameLayout>
</LinearLayout>
