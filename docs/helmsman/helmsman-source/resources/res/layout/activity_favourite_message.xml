<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/activity_favourite_message"
    android:fitsSystemWindows="true"
    android:clipToPadding="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="0dp"
        app:cardElevation="20px">
        <im.helmsman.helmsmanandroid.view.TitleBar
            android:id="@+id/titleBar"
            android:background="@color/title_red"
            android:layout_width="match_parent"
            android:layout_height="168px"
            app:left_drawable="0x7f0701db"
            app:textColor="@color/white"
            app:title="@string/favourite_notifitcation"/>
    </androidx.cardview.widget.CardView>
    <com.chanven.lib.cptr.PtrClassicFrameLayout
        android:id="@+id/swipe_refresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ListView
            android:id="@+id/lv_favourite_message_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@drawable/listline_magrinleft"
            android:dividerHeight="3px"/>
    </com.chanven.lib.cptr.PtrClassicFrameLayout>
</LinearLayout>
