<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <de.hdodenhof.circleimageview.CircleImageView
        android:id="@+id/civ_comment_notification_avatar"
        android:layout_width="120px"
        android:layout_height="120px"
        android:layout_marginLeft="48px"
        android:layout_marginTop="48px"/>
    <TextView
        android:textSize="42px"
        android:textColor="@color/black"
        android:id="@+id/tv_comment_notification_username"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="220px"
        android:layout_marginTop="48px"/>
    <TextView
        android:textSize="48px"
        android:textColor="#89000000"
        android:id="@+id/tv_comment_notification_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="220px"
        android:layout_marginTop="110px"
        android:layout_marginBottom="48px"/>
    <TextView
        android:textSize="32px"
        android:textColor="#4d444444"
        android:id="@+id/tv_comment_notification_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="48px"
        android:layout_alignParentRight="true"/>
</RelativeLayout>
