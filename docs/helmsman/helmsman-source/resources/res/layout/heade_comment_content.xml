<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="1032px">
    <ImageView
        android:id="@+id/iv_comment_content_map"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"/>
    <RelativeLayout
        android:layout_gravity="bottom"
        android:background="#80424242"
        android:layout_width="match_parent"
        android:layout_height="392px">
        <TextView
            android:textSize="72px"
            android:textColor="@color/white"
            android:id="@+id/tv_comment_content_username"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="48px"
            android:layout_marginTop="72px"/>
        <TextView
            android:textSize="42px"
            android:textColor="@color/white"
            android:id="@+id/tv_comment_content_content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="48px"
            android:layout_marginTop="173px"/>
        <TextView
            android:textSize="42px"
            android:textColor="@color/white"
            android:id="@+id/tv_comment_content_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="93px"
            android:layout_marginRight="48px"
            android:layout_alignParentRight="true"/>
    </RelativeLayout>
</FrameLayout>
