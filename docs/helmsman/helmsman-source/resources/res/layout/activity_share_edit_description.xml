<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:clipToPadding="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/cardview"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="5dp">
        <im.helmsman.helmsmanandroid.view.TitleBar
            android:id="@+id/titleBar"
            android:background="@color/title_red"
            android:layout_width="match_parent"
            android:layout_height="168px"
            app:left_drawable="0x7f0701db"
            app:textColor="@color/white"
            app:title="@string/setting_help">
            <ImageView
                android:id="@+id/iv_send"
                android:layout_width="60px"
                android:layout_height="60px"
                android:layout_marginRight="57px"
                android:src="0x7f070250"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"/>
        </im.helmsman.helmsmanandroid.view.TitleBar>
    </FrameLayout>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <EditText
            android:id="@+id/et_share_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="48px"
            android:layout_marginTop="232px"
            android:layout_marginRight="48px"
            android:hint="@string/youy_thoung"
            android:maxLength="140"/>
        <TextView
            android:textSize="36px"
            android:textColor="#89000000"
            android:id="@+id/tv_send_message_text_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24px"
            android:layout_marginRight="48px"
            android:text="0 / 140"
            android:layout_below="@+id/et_share_description"
            android:layout_alignParentRight="true"/>
    </RelativeLayout>
    <RelativeLayout
        android:layout_gravity="bottom"
        android:id="@+id/rel_send_message_at"
        android:layout_width="match_parent"
        android:layout_height="100px"
        android:layout_marginBottom="30px">
        <TextView
            android:textSize="48px"
            android:textColor="#545454"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="48px"
            android:text="@string/atmention"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
</FrameLayout>
