<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <im.helmsman.helmsmanandroid.view.TitleBar
        android:id="@+id/titleBar"
        android:background="@color/title_red"
        android:layout_width="match_parent"
        android:layout_height="168px"
        app:left_drawable="0x7f0701db"
        app:textColor="@color/white"
        app:title="@string/edit_friend"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@color/title_red"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="104px">
        <TextView
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:id="@+id/tv_friendsactivity_follower"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/friendsactivity_Follower"
            android:layout_weight="1"/>
        <TextView
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:id="@+id/tv_friendsactivity_following"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/friendsactivity_following"
            android:layout_weight="1"/>
    </LinearLayout>
    <View
        android:id="@+id/view"
        android:background="#49ff7f"
        android:layout_width="540px"
        android:layout_height="5px"/>
    <androidx.viewpager.widget.ViewPager
        android:id="@+id/viepager_friendactivity"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</LinearLayout>
