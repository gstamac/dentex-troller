<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/setting_bg"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/cardview"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="5dp">
        <im.helmsman.helmsmanandroid.view.TitleBar
            android:id="@+id/titleBar"
            android:background="@color/title_red"
            android:layout_width="match_parent"
            android:layout_height="168px"
            app:left_drawable="0x7f0701db"
            app:textColor="@color/white"
            app:title="@string/setting_setting"/>
    </FrameLayout>
    <im.helmsman.helmsmanandroid.view.OverScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/cardview">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/lin_setting_overscroll"
            android:clickable="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <RelativeLayout
                android:background="@drawable/bg_setting_item_no_underline"
                android:layout_width="match_parent"
                android:layout_height="66dp">
                <ImageView
                    android:id="@+id/iv_setting_coor"
                    android:layout_width="@dimen/item_icon_size"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginRight="8dp"
                    android:layout_marginBottom="8dp"
                    android:src="0x7f0701e5"/>
                <TextView
                    android:textColor="@color/black"
                    android:id="@+id/tv_setting_china_optimization"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:layout_marginTop="16dp"
                    android:text="@string/china_optimization"
                    android:layout_toRightOf="@+id/iv_setting_coor"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="#a1a1a1"
                    android:layout_width="234dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@string/restartapp_take_effect"
                    android:layout_below="@+id/tv_setting_china_optimization"
                    android:layout_alignLeft="@+id/tv_setting_china_optimization"/>
                <Switch
                    android:id="@+id/sv_ischina_opimization"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginRight="16dp"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"/>
            </RelativeLayout>
            <RelativeLayout
                android:background="@drawable/bg_setting_item_no_underline"
                android:layout_width="match_parent"
                android:layout_height="@dimen/item_height">
                <ImageView
                    android:id="@+id/iv_setting_vibration"
                    android:layout_width="@dimen/item_icon_size"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginRight="8dp"
                    android:layout_marginBottom="8dp"
                    android:src="0x7f07024b"
                    android:layout_centerVertical="true"/>
                <TextView
                    android:textColor="@color/black"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:text="@string/setting_vibration"
                    android:layout_toRightOf="@+id/iv_setting_vibration"
                    android:layout_centerVertical="true"/>
                <Switch
                    android:id="@+id/sv_isvibrator"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginRight="16dp"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/rel_setting_calibration"
                android:background="@drawable/ripple_bg"
                android:layout_width="match_parent"
                android:layout_height="@dimen/item_height">
                <ImageView
                    android:id="@+id/iv_setting_calibration"
                    android:layout_width="@dimen/item_icon_size"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginRight="8dp"
                    android:layout_marginBottom="8dp"
                    android:src="0x7f070248"
                    android:layout_centerVertical="true"/>
                <TextView
                    android:textColor="@color/black"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:text="@string/setting_heading_calibration"
                    android:layout_toRightOf="@+id/iv_setting_calibration"
                    android:layout_centerVertical="true"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/rel_navi_mode"
                android:background="@drawable/ripple_bg"
                android:layout_width="match_parent"
                android:layout_height="@dimen/item_height">
                <ImageView
                    android:id="@+id/iv_setting_navi"
                    android:layout_width="@dimen/item_icon_size"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginRight="8dp"
                    android:layout_marginBottom="8dp"
                    android:src="0x7f07024a"
                    android:layout_centerVertical="true"/>
                <TextView
                    android:textColor="@color/black"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:text="@string/setting_navi_mode"
                    android:layout_toRightOf="@+id/iv_setting_navi"
                    android:layout_centerVertical="true"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/rel_navi_log"
                android:background="@drawable/ripple_bg"
                android:layout_width="match_parent"
                android:layout_height="@dimen/item_height">
                <ImageView
                    android:id="@+id/iv_setting_log"
                    android:layout_width="@dimen/item_icon_size"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginRight="8dp"
                    android:layout_marginBottom="8dp"
                    android:src="0x7f070249"
                    android:layout_centerVertical="true"/>
                <TextView
                    android:textColor="@color/black"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:text="@string/diagnostics"
                    android:layout_toRightOf="@+id/iv_setting_log"
                    android:layout_centerVertical="true"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/rel_unit_convert"
                android:background="@drawable/ripple_bg"
                android:layout_width="match_parent"
                android:layout_height="@dimen/item_height">
                <ImageView
                    android:id="@+id/iv_setting_unit_convert"
                    android:padding="1dp"
                    android:layout_width="@dimen/item_icon_size"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginRight="8dp"
                    android:layout_marginBottom="8dp"
                    android:src="0x7f070253"
                    android:layout_centerVertical="true"/>
                <TextView
                    android:textColor="@color/black"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:text="@string/setting_unitconcersion"
                    android:layout_toRightOf="@+id/iv_setting_unit_convert"
                    android:layout_centerVertical="true"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/rel_wifi_password"
                android:background="@drawable/ripple_bg"
                android:layout_width="match_parent"
                android:layout_height="@dimen/item_height">
                <ImageView
                    android:id="@+id/iv_setting_wifi_password"
                    android:padding="2dp"
                    android:layout_width="@dimen/item_icon_size"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginRight="8dp"
                    android:layout_marginBottom="8dp"
                    android:src="0x7f07025f"
                    android:layout_centerVertical="true"/>
                <TextView
                    android:textColor="@color/black"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:text="@string/setting_modify_wifi_password"
                    android:layout_toRightOf="@+id/iv_setting_wifi_password"
                    android:layout_centerVertical="true"/>
            </RelativeLayout>
        </LinearLayout>
    </im.helmsman.helmsmanandroid.view.OverScrollView>
</RelativeLayout>
