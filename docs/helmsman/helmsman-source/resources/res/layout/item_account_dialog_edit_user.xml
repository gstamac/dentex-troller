<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:paddingLeft="16dp"
    android:paddingTop="8dp"
    android:paddingRight="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <EditText
                android:id="@+id/et_account_dialog_edit_user"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/userinfofragment_editusername_hint"
                android:singleLine="true"
                android:maxLength="30"
                android:inputType="textNoSuggestions"/>
        </com.google.android.material.textfield.TextInputLayout>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/iv_account_dialog_user_dismiss"
            android:padding="8dp"
            android:visibility="gone"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/icon_dismiss_gray"/>
    </FrameLayout>
    <TextView
        android:textSize="10sp"
        android:textColor="@color/red"
        android:id="@+id/tv_account_dialog_format"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="名字格式不正确"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <Button
            android:id="@+id/btn_account_dialog_cancle"
            android:background="@null"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/cancle"
            android:layout_weight="1"/>
        <Button
            android:id="@+id/btn_account_dialog_positive"
            android:background="@null"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/app_ok"
            android:layout_weight="1"/>
    </LinearLayout>
</LinearLayout>
