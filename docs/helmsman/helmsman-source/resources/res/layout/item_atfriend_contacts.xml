<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/rel_atfriend_item_index_layout"
        android:layout_width="match_parent"
        android:layout_height="144px">
        <View
            android:background="#c6c6c6"
            android:layout_width="match_parent"
            android:layout_height="1px"
            android:layout_marginLeft="215px"
            android:layout_alignParentTop="true"/>
        <TextView
            android:textSize="42px"
            android:textColor="#8a000000"
            android:id="@+id/tv_atfriend_item_contact_index"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="48px"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="168px">
        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/civ_atfriend_item_contact_avatar"
            android:layout_width="120px"
            android:layout_height="120px"
            android:layout_marginLeft="48px"
            android:layout_centerVertical="true"/>
        <TextView
            android:textSize="48px"
            android:textColor="#444444"
            android:id="@+id/tv_atfriend_item_contact_username"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="216px"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
</LinearLayout>
